{
  "name": "antigravity-gateway",
  "version": "0.3.0",
  "description": "Universal 20-channel messaging gateway (Photon iMessage, Telegram, Discord, Slack, and more) for Google Antigravity CLI (agy acp).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Relogys/Antigravity-gateway.git"
  },
  "homepage": "https://github.com/Relogys/Antigravity-gateway#readme",
  "bugs": {
    "url": "https://github.com/Relogys/Antigravity-gateway/issues"
  },
  "keywords": [
    "antigravity",
    "acp",
    "gateway",
    "imessage",
    "photon",
    "telegram",
    "discord",
    "slack",
    "chatbot",
    "agent"
  ],
  "files": [
    "dist",
    "scripts/audit-secrets.mjs",
    "scripts/start-gateway.ps1",
    "scripts/install-task.ps1",
    "scripts/uninstall-task.ps1",
    "scripts/start-gateway.sh",
    "scripts/install-launchd.sh",
    "scripts/uninstall-launchd.sh",
    "scripts/install-systemd.sh",
    "scripts/uninstall-systemd.sh",
    "docs",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "antigravity-gateway": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts init",
    "gateway:start": "tsx src/cli.ts start",
    "gateway:stop": "tsx src/cli.ts stop",
    "gateway:logs": "tsx src/cli.ts logs",
    "gateway:service": "tsx src/cli.ts service",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:acp": "tsx scripts/probe-acp.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "@larksuiteoapi/node-sdk": "^1.77.0",
    "@slack/bolt": "^5.1.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.7",
    "spectrum-ts": "^12.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
