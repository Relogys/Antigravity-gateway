{
  "name": "antigravity-gateway",
  "version": "0.1.0",
  "description": "Dedicated iMessage (Photon Spectrum) gateway for Google Antigravity CLI (agy acp).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "antigravity-gateway": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "setup": "tsx src/cli.ts init",
    "gateway:start": "tsx src/cli.ts start",
    "gateway:stop": "tsx src/cli.ts stop",
    "gateway:logs": "tsx src/cli.ts logs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:acp": "tsx scripts/probe-acp.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "@larksuiteoapi/node-sdk": "^1.77.0",
    "@slack/bolt": "^5.1.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.7",
    "spectrum-ts": "^12.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
