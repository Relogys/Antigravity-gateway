# ───────────────────────────────────────────────────────────────────────────
# Antigravity Gateway — multi-channel configuration
# Every channel is OPTIONAL and enabled only when its credentials are set.
# At least one channel must be configured. Leave unused values blank.
# Per-channel *_ALLOWED_USERS are comma-separated platform user ids; they are
# unioned with ALLOWED_SENDERS and paired senders. Empty everywhere = deny all
# (DMs receive an 8-character pairing code instead).
# ───────────────────────────────────────────────────────────────────────────

# Photon / Spectrum iMessage (enabled iff BOTH are set)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_READ_RECEIPTS=true
PHOTON_REACTIONS=true
PHOTON_MAX_CHUNK_CHARS=1600
PHOTON_HEARTBEAT_TIMEOUT_MS=180000
PHOTON_PROBE_SPACE_ID=
# Enabled Photon native slash commands: all (default) | none | comma-separated subset (poll,bg,unsend,card)
PHOTON_NATIVE_COMMANDS=all

# Telegram (Bot API long polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_POLL_TIMEOUT_SEC=30

# Discord (discord.js)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOW_GUILDS=false

# Slack (Socket Mode: bot token xoxb-... + app-level token xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=

# Feishu / Lark (domain: feishu | lark)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_ALLOWED_USERS=

# DingTalk (Stream mode)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=

# OneBot v11 / QQ (reverse-WS client; e.g. ws://127.0.0.1:3001)
ONEBOT_WS_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_SELF_ID=
ONEBOT_ALLOWED_USERS=

# Generic Webhook / HTTP (binds loopback 127.0.0.1 by default; health uses 18790)
WEBHOOK_ENABLED=false
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=18791
WEBHOOK_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_CALLBACK_URL=
# Optional: pin inbound webhook senderId to a fixed identity & enforce signed timestamp/nonce anti-replay
# Note: when WEBHOOK_HOST is non-loopback, anti-replay timestamp/id verification defaults to true unless set to false.
WEBHOOK_FIXED_SENDER=
WEBHOOK_REQUIRE_TIMESTAMP=
WEBHOOK_REPLAY_WINDOW_SEC=300
WEBHOOK_ALLOWED_USERS=

# WeCom / Enterprise WeChat (enabled iff corp id, agent id, and secret are set)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_HOST=127.0.0.1
WECOM_PORT=18792
WECOM_ALLOWED_USERS=

# QQ Bot (enabled iff app id and client secret are set)
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=
QQBOT_SANDBOX=false
QQBOT_ALLOWED_USERS=

# Matrix (enabled iff homeserver URL and access token are set)
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
MATRIX_ALLOWED_USERS=

# Mattermost (enabled iff base URL and bot token are set)
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_ALLOWED_USERS=

# LINE Messaging API (enabled iff access token and channel secret are set)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_HOST=127.0.0.1
LINE_PORT=18793
LINE_ALLOWED_USERS=

# IRC (enabled when a host is set; channels are comma-separated)
IRC_HOST=
IRC_PORT=6697
IRC_TLS=true
IRC_NICK=antigravity-bot
IRC_PASSWORD=
IRC_CHANNELS=
IRC_ALLOWED_USERS=

# WhatsApp Cloud API (Meta Graph API; enabled iff access token + phone number id are set)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_HOST=127.0.0.1
WHATSAPP_WEBHOOK_PORT=18794
WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook
WHATSAPP_ALLOWED_USERS=

# Zulip (Real-Time Events API long-polling behind NAT; enabled iff site + email + api key are set)
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_API_KEY=
ZULIP_STREAMS=
ZULIP_REQUIRE_MENTION=true
ZULIP_ALLOWED_USERS=

# Rocket.Chat (DDP WebSocket behind NAT + REST v1; enabled iff url + user id + auth token are set)
ROCKETCHAT_URL=
ROCKETCHAT_USER_ID=
ROCKETCHAT_AUTH_TOKEN=
ROCKETCHAT_REQUIRE_MENTION=true
ROCKETCHAT_ALLOWED_USERS=

# Signal (via self-hosted signal-cli-rest-api WS/poll behind NAT; enabled iff api url + account are set)
SIGNAL_API_URL=
SIGNAL_ACCOUNT=
SIGNAL_POLL_INTERVAL_MS=3000
SIGNAL_ALLOWED_USERS=

# Microsoft Teams (Outgoing Webhook HMAC or Bot Framework or Incoming Webhook)
TEAMS_WEBHOOK_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=botframework.com
TEAMS_INCOMING_WEBHOOK_URL=
TEAMS_WEBHOOK_HOST=127.0.0.1
TEAMS_WEBHOOK_PORT=18795
TEAMS_WEBHOOK_PATH=/teams/messages
TEAMS_ALLOWED_USERS=

# Google Chat (Chat App webhook + REST API or Incoming Webhook)
# Recommended for public HTTP endpoints: set GOOGLECHAT_AUDIENCE to verify Google RS256 OIDC JWTs.
GOOGLECHAT_WEBHOOK_URL=
GOOGLECHAT_ACCESS_TOKEN=
GOOGLECHAT_VERIFICATION_TOKEN=
GOOGLECHAT_AUDIENCE=
GOOGLECHAT_WEBHOOK_HOST=127.0.0.1
GOOGLECHAT_WEBHOOK_PORT=18796
GOOGLECHAT_WEBHOOK_PATH=/googlechat/events
GOOGLECHAT_ALLOWED_USERS=

# Global access control. Photon entries are E.164 phone numbers / Apple ID emails.
# Entries for other channels use "<channel>:<userId>" (e.g. telegram:123456789).
ALLOWED_SENDERS=+15550001111,user@example.com
# Optional admin senders allowed to override group approvals or toggle /yolo in group chats
ADMIN_SENDERS=
ALLOW_GROUPS=false
GROUP_MENTION_PATTERNS=@agy,@antigravity

# Antigravity CLI (`agy`) backend
AGY_BIN=agy
# Optional comma-separated extra env var names to pass through to `agy` (channel secrets are always stripped)
AGY_PASSTHROUGH_ENV=
DEFAULT_CWD=.
# Optional named workspace bookmarks for quick mobile switching via `/cwd @alias` (comma or semicolon separated)
# Example: WORKSPACE_ALIASES=api=/srv/api,web=/srv/web
WORKSPACE_ALIASES=
# Optional per-channel default workspace overrides: PHOTON_CWD=, TELEGRAM_CWD=, DISCORD_CWD=, ...
APPROVAL_MODE=interactive
# Default busy-turn policy for new chats: steer (live mid-turn interjection, default) | queue (FIFO) | interrupt (cancel & replace)
DEFAULT_BUSY_MODE=steer
DEFAULT_MODEL=
DEFAULT_EFFORT=

# Optional: Gemini API key (uses cached `agy` OAuth session when omitted)
GEMINI_API_KEY=

# Optional local health & Prometheus metrics endpoint (disabled by default; binds loopback 127.0.0.1:18790)
HEALTH_ENABLED=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=18790
# Optional Bearer token protecting GET /status and GET /metrics (strongly recommended if HEALTH_HOST is non-loopback)
HEALTH_TOKEN=

# Warn when 5-hour quota remaining drops below this percentage (0-100)
QUOTA_WARN_THRESHOLD=15

# Long-turn feedback (all optional; set to 0 to disable a signal)
# Send a progress pulse after this many ms of total silence during a turn.
PROGRESS_SILENCE_MS=120000
# Warn once per turn when the model/tools have been silent for this long.
SESSION_STALL_TIMEOUT_MS=300000
# Live tool-call progress display: auto | edit | silence | off
# "auto" edits one live status card in-place on Telegram/Discord/Slack and uses silence pulses on iMessage.
TOOL_PROGRESS_MODE=auto
# Keep the tool-call progress message after the final reply arrives? false = delete it (clean chat), true = keep summary.
TOOL_PROGRESS_KEEP=false
# Minimum interval (ms) between live in-place progress edits to respect platform rate limits.
TOOL_PROGRESS_EDIT_INTERVAL_MS=1500
# Flush pre-tool-call assistant replies immediately as separate chat bubbles before tool execution (default: true).
STREAM_INTERMEDIATE_REPLIES=true
# Retries for transient ACP turn failures before surfacing an error.
TURN_MAX_RETRIES=2
# Coalesce rapid-fire chat bubbles sent within this window (ms); 0 disables.
INGRESS_DEBOUNCE_MS=350
# Auto-create a channel-grouped session binding for each active channel at startup.
AUTO_BOOTSTRAP_CHANNEL_SESSION=true

# Persistence & logging
DATA_DIR=./data
# Optional log directory override (defaults to user-writable <DATA_DIR>/logs for global npm installs, else ./logs)
LOG_DIR=
LOG_LEVEL=info
# Log output format: text (default) | json (structured single-line JSON with secret redaction)
LOG_FORMAT=text
