# ───────────────────────────────────────────────────────────────────────────
# Antigravity Gateway — multi-channel configuration
# Every channel is OPTIONAL and enabled only when its credentials are set.
# At least one channel must be configured. Leave unused values blank.
# Per-channel *_ALLOWED_USERS are comma-separated platform user ids; they are
# unioned with ALLOWED_SENDERS and paired senders. Empty everywhere = deny all
# (DMs receive an 8-character pairing code instead).
# ───────────────────────────────────────────────────────────────────────────

# Photon / Spectrum iMessage (enabled iff BOTH are set)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_READ_RECEIPTS=true
PHOTON_REACTIONS=true

# Telegram (Bot API long polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_POLL_TIMEOUT_SEC=30

# Discord (discord.js)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOW_GUILDS=false

# Slack (Socket Mode: bot token xoxb-... + app-level token xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=

# Feishu / Lark (domain: feishu | lark)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_ALLOWED_USERS=

# DingTalk (Stream mode)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=

# OneBot v11 / QQ (reverse-WS client; e.g. ws://127.0.0.1:3001)
ONEBOT_WS_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_SELF_ID=
ONEBOT_ALLOWED_USERS=

# Generic Webhook / HTTP (avoid Hermes ports 8789/9119/8765; health uses 18790)
WEBHOOK_ENABLED=false
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=18791
WEBHOOK_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_CALLBACK_URL=
WEBHOOK_ALLOWED_USERS=

# WeCom / Enterprise WeChat (enabled iff corp id, agent id, and secret are set)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_HOST=127.0.0.1
WECOM_PORT=18792
WECOM_ALLOWED_USERS=

# QQ Bot (enabled iff app id and client secret are set)
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=
QQBOT_SANDBOX=false
QQBOT_ALLOWED_USERS=

# Matrix (enabled iff homeserver URL and access token are set)
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=
MATRIX_ALLOWED_USERS=

# Mattermost (enabled iff base URL and bot token are set)
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_ALLOWED_USERS=

# LINE Messaging API (enabled iff access token and channel secret are set)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_HOST=127.0.0.1
LINE_PORT=18793
LINE_ALLOWED_USERS=

# IRC (enabled when a host is set; channels are comma-separated)
IRC_HOST=
IRC_PORT=6697
IRC_TLS=true
IRC_NICK=antigravity-bot
IRC_PASSWORD=
IRC_CHANNELS=
IRC_ALLOWED_USERS=

# Global access control. Photon entries are E.164 phone numbers / Apple ID emails.
# Entries for other channels use "<channel>:<userId>" (e.g. telegram:123456789).
ALLOWED_SENDERS=+15550001111,user@example.com
ALLOW_GROUPS=false
GROUP_MENTION_PATTERNS=@agy,@antigravity

# Antigravity CLI (`agy`) backend
AGY_BIN=agy
DEFAULT_CWD=.
APPROVAL_MODE=interactive
DEFAULT_MODEL=
DEFAULT_EFFORT=

# Optional: Gemini API key (uses cached `agy` OAuth session when omitted)
GEMINI_API_KEY=

# Optional local health endpoint (disabled by default; avoid Hermes ports 8789/9119/8765)
HEALTH_ENABLED=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=18790

# Warn when 5-hour quota remaining drops below this percentage (0-100)
QUOTA_WARN_THRESHOLD=15

# Persistence & logging
DATA_DIR=./data
LOG_LEVEL=info
